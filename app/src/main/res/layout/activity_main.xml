<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <ViewFlipper
        android:id="@+id/screenFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateFirstView="false"
        android:inAnimation="@anim/slide_in_right"
        android:outAnimation="@anim/slide_out_left">

        <include
            android:id="@+id/screenHome"
            layout="@layout/screen_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenReview"
            layout="@layout/screen_review"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenProgress"
            layout="@layout/screen_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenResult"
            layout="@layout/screen_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenExtensions"
            layout="@layout/screen_extensions"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </ViewFlipper>

</FrameLayout>
