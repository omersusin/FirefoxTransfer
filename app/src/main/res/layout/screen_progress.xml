<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.16"
            android:text="@string/brand"
            android:textColor="@color/md_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/progress_title"
            android:textAppearance="@style/TextAppearance.BrowserMigrator.Display"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/progress_subtitle"
            android:textAppearance="@style/TextAppearance.BrowserMigrator.Body"
            android:textSize="13sp" />

        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="38dp"
            app:containerColor="@color/md_primary_container"
            app:containerHeight="92dp"
            app:containerWidth="92dp"
            app:indicatorColor="@color/md_on_primary_container"
            app:indicatorSize="58dp" />

        <TextView
            android:id="@+id/txtProgressPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/progress_percent"
            android:textAppearance="@style/TextAppearance.BrowserMigrator.Display"
            android:textColor="@color/md_on_background"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/txtProgressPhase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/progress_preparing"
            android:textAppearance="@style/TextAppearance.BrowserMigrator.Title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtProgressStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/progress_step"
            android:textAppearance="@style/TextAppearance.BrowserMigrator.Body"
            android:textSize="12sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0"
            app:indicatorColor="@color/md_primary"
            app:trackColor="@color/md_surface_container_high"
            app:trackCornerRadius="8dp"
            app:trackHeight="10dp" />

        <TextView
            android:id="@+id/txtProgressDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/do_not_close"
            android:textAppearance="@style/TextAppearance.BrowserMigrator.Body"
            android:textSize="11sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/md_surface_container_low">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_description"
                        android:tint="@color/md_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/log_title"
                        android:textAppearance="@style/TextAppearance.BrowserMigrator.Label"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleLog"
                        style="@style/Widget.BrowserMigrator.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_show" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/scrollLog"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_log_panel"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BrowserMigrator.Mono"
                        android:textIsSelectable="true" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/do_not_close"
            android:textAppearance="@style/TextAppearance.BrowserMigrator.Body"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
